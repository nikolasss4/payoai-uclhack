# Copy the names into per-process local files. Those files are git-ignored, so never commit values.

# .env.shared (all processes)
DATABASE_URL=
PROVIDER_MODE=simulator

# .env.agent (agent-worker only)
GEMINI_API_KEY=

# .env.money (money-worker only, for real rails if they're added)
AIRWALLEX_API_KEY=
WISE_API_TOKEN=
CIRCLE_API_KEY=
TESTNET_SIGNER_KEY=
CHAIN_RPC_URL=
TEST_CARD_TOKEN=

# .env.api (api only)
SESSION_SECRET=
WEBHOOK_SECRET_SIMULATOR=
